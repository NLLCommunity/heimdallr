package pages

import (
	"fmt"
	"strconv"

	"github.com/NLLCommunity/heimdallr/model"
	"github.com/NLLCommunity/heimdallr/web/templates/components"
	"github.com/NLLCommunity/heimdallr/web/templates/layouts"
)

type StarboardsData struct {
	GuildID      string
	MasterEnabled bool
	Boards       []model.Starboard
	Channels     []components.ChannelGroup
	Notice       string
	Error        string
}

templ Starboards(nav layouts.NavData, data StarboardsData) {
	@layouts.Base("Starboards", nav) {
		<header class="starboards-heading">
			<div>
				<h2>Starboards</h2>
				<p>Publish highly reacted messages into dedicated highlight channels.</p>
			</div>
		</header>
		if data.Notice != "" {
			@components.AlertSuccess(data.Notice)
		}
		if data.Error != "" {
			@components.AlertError(data.Error)
		}
		<article>
			<h3>Server control</h3>
			<form method="POST" action={ templ.SafeURL("/guild/" + data.GuildID + "/starboards/master") } x-data="formTracker()" @change="checkDirty()">
				@components.ToggleField("enabled", "Enable starboards", "This master switch controls automatic publishing and score updates for every board. Existing copies remain when disabled.", data.MasterEnabled)
				@components.SaveButton()
			</form>
		</article>

		<section aria-labelledby="configured-starboards">
			<h3 id="configured-starboards">Configured boards</h3>
			if len(data.Boards) == 0 {
				<p class="starboards-empty">No boards configured yet. Create the first one below.</p>
			}
			<div class="starboard-list">
				for _, board := range data.Boards {
					@starboardEditor(data, board)
				}
			</div>
		</section>

		<article id="new-starboard">
			<h3>Create a board</h3>
			<form method="POST" action={ templ.SafeURL("/guild/" + data.GuildID + "/starboards") } x-data="formTracker()" @input="checkDirty()" @change="checkDirty()">
				<div class="grid">
					<label for="new-board-name">
						Name
						<input id="new-board-name" name="name" type="text" maxlength="80" required placeholder="Highlights"/>
					</label>
					@starboardChannelSelect("new-board-channel", "channel", "Destination channel", data.Channels, "", true, false)
				</div>
				<div class="grid">
					<label for="new-board-emoji">
						Positive emoji
						<input id="new-board-emoji" name="emoji" type="text" value="⭐" required/>
					</label>
					<label for="new-board-threshold">
						Minimum score
						<input id="new-board-threshold" name="threshold" type="number" value="4" min="1" step="1" required/>
					</label>
				</div>
				@components.ToggleField("enabled", "Enable this board", "The server master switch must also be enabled before messages publish.", false)
				@components.SaveButton()
			</form>
		</article>
	}
}

templ starboardEditor(data StarboardsData, board model.Starboard) {
	<article class="starboard-card" id={ fmt.Sprintf("board-%d", board.ID) }>
		<header class="starboard-card-heading">
			<div>
				<h4>{ board.Name }</h4>
				<small>Board ID { strconv.FormatUint(board.ID, 10) }</small>
			</div>
			if board.Deleting {
				<span class="starboard-state" role="status">Cleanup pending</span>
			}
		</header>
		<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/guild/%s/starboards/%d", data.GuildID, board.ID)) } x-data="formTracker()" @input="checkDirty()" @change="checkDirty()">
			<fieldset disabled?={ board.Deleting }>
				<div class="grid">
					<label for={ fmt.Sprintf("board-%d-name", board.ID) }>
						Name
						<input id={ fmt.Sprintf("board-%d-name", board.ID) } name="name" type="text" value={ board.Name } maxlength="80" required/>
					</label>
					@starboardChannelSelect(fmt.Sprintf("board-%d-channel", board.ID), "channel", "Destination channel", data.Channels, board.ChannelID.String(), true, board.Deleting)
				</div>
				<div class="grid">
					<label for={ fmt.Sprintf("board-%d-emoji", board.ID) }>
						Positive emoji
						<input id={ fmt.Sprintf("board-%d-emoji", board.ID) } name="emoji" type="text" value={ board.Emoji } required/>
					</label>
					<label for={ fmt.Sprintf("board-%d-threshold", board.ID) }>
						Minimum score
						<input id={ fmt.Sprintf("board-%d-threshold", board.ID) } name="threshold" type="number" value={ strconv.Itoa(board.Threshold) } min="1" step="1" required/>
					</label>
				</div>
				@components.ToggleField("enabled", "Enable this board", "The server master switch must also be enabled before messages publish.", board.Enabled)
				<p class="starboard-consequence">
					Changing the destination or positive emoji removes this board's existing copies, then reevaluates tracked messages with the new settings.
				</p>
				@components.SaveButton()
			</fieldset>
		</form>
		if !board.Deleting {
			<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/guild/%s/starboards/%d/delete", data.GuildID, board.ID)) } class="starboard-delete-form">
				<button type="submit" class="btn-danger outline" onclick="return confirm('Delete this board and remove all of its copies?')">Delete board</button>
			</form>
		}
	</article>
}

templ starboardChannelSelect(id string, name string, label string, groups []components.ChannelGroup, selected string, required bool, disabled bool) {
	<label for={ id }>
		{ label }
		<select id={ id } name={ name } required?={ required } disabled?={ disabled }>
			<option value="">— Select a channel —</option>
			if selected != "" && !starboardChannelAvailable(groups, selected) {
				<option value={ selected } selected>Unavailable channel ({ selected })</option>
			}
			for _, group := range groups {
				if group.Name == "" {
					for _, ch := range group.Channels {
						<option value={ ch.ID } selected?={ ch.ID == selected }>#{ ch.Name }</option>
					}
				} else {
					<optgroup label={ group.Name }>
						for _, ch := range group.Channels {
							<option value={ ch.ID } selected?={ ch.ID == selected }>#{ ch.Name }</option>
						}
					</optgroup>
				}
			}
		</select>
	</label>
}

func starboardChannelAvailable(groups []components.ChannelGroup, selected string) bool {
	for _, group := range groups {
		for _, channel := range group.Channels {
			if channel.ID == selected {
				return true
			}
		}
	}
	return false
}
