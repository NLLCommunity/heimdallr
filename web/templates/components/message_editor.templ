package components

// MessageEditor binds Lit to an Alpine component-array expression. form=""
// detaches native submission: the host submits drafts through its own input.
templ MessageEditor(binding string) {
	<div class="message-editor" data-component-editor data-editor-state="loading" x-component-editor={ binding }>
		<p data-editor-status role="status" tabindex="-1">Loading message editor…</p>
		<discord-message-editor form="" aria-label="Message components" x-ignore></discord-message-editor>
		<details class="message-preview" open>
			<summary>Preview</summary>
			<discord-message-preview aria-label="Message preview" x-ignore></discord-message-preview>
		</details>
	</div>
}
